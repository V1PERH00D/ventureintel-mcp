\r\n  competitive_confidence: competitive.confidence ?? null,\r\n  risk: risk.score ?? null,\r\n  risk_confidence: risk.confidence ?? null,\r\n  execution: advisor.score ?? null,\r\n  execution_confidence: advisor.confidence ?? null,\r\n  timing: null,\r\n  upside: null,\r\n  composite: null,\r\n  composite_pct: null\r\n};\r\n\r\nconst parsedScores = finalReport.match(/MARKET_SCORE:(\\d+(?:\\.\\d+)?)\\s+COMPETITIVE_SCORE:(\\d+(?:\\.\\d+)?)\\s+RISK_SCORE:(\\d+(?:\\.\\d+)?)\\s+EXECUTION_SCORE:(\\d+(?:\\.\\d+)?)\\s+TIMING_SCORE:(\\d+(?:\\.\\d+)?)\\s+UPSIDE_SCORE:(\\d+(?:\\.\\d+)?)\\s+COMPOSITE_SCORE:(\\d+(?:\\.\\d+)?)\\s+COMPOSITE_PCT:(\\d+(?:\\.\\d+)?)/i);\r\nif (parsedScores) {\r\n  scores.market = parseFloat(parsedScores[1]);\r\n  scores.competitive = parseFloat(parsedScores[2]);\r\n  scores.risk = parseFloat(parsedScores[3]);\r\n  scores.execution = parseFloat(parsedScores[4]);\r\n  scores.timing = parseFloat(parsedScores[5]);\r\n  scores.upside = parseFloat(parsedScores[6]);\r\n  scores.composite = parseFloat(parsedScores[7]);\r\n  scores.composite_pct = parseFloat(parsedScores[8]);\r\n}\r\n\r\nconst reportSections = {\r\n  executive_summary: executiveSummary,\r\n  market_analysis: aggregated.market_summary || market.summary || '',\r\n  competition_analysis: aggregated.competitive_summary || competitive.summary || '',\r\n  risk_analysis: aggregated.risk_summary || risk.summary || '',\r\n  advisor_notes: aggregated.advisor_summary || advisor.summary || '',\r\n  final_decision: investmentDecision,\r\n  committee_discussion: committeeDiscussion,\r\n  key_risks: keyRisks,\r\n  key_opportunities: keyOpportunities\r\n};\r\n\r\nconst cacheDoc = {\r\n  session_id: aggregated.session_id,\r\n  cache_key: aggregated.cache_key,\r\n  startup_idea: aggregated.startup_idea,\r\n  target_market: aggregated.target_market,\r\n  stage: aggregated.stage,\r\n  founder_context: aggregated.founder_context,\r\n  geography: aggregated.geography,\r\n  industry: aggregated.industry,\r\n  fin