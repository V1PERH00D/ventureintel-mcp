        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst sessionId = body.session_id || ('vi_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9));\nconst startupIdea = (body.startup_idea || '').trim();\nconst targetMarket = (body.target_market || '').trim();\nconst founderContext = (body.founder_context || '').trim();\nconst stage = body.stage || 'Idea';\nconst industry = (body.industry || '').trim();\nconst geography = (body.geography || 'Global').trim();\n\nif (!startupIdea || !targetMarket) {\n  throw new Error('startup_idea and target_market are required fields.');\n}\nif (startupIdea.length < 20) {\n  throw new Error('startup_idea is too short — please describe your idea in at least 20 characters.');\n}\n\nconst cacheKeySource = `${startupIdea}::${targetMarket}`;\nlet cacheKey = 0;\nfor (let index = 0; index < cacheKeySource.length; index += 1) {\n  cacheKey = ((cacheKey << 5) - cacheKey) + cacheKeySource.charCodeAt(index);\n  cacheKey |= 0;\n}\n\nreturn [{\n  json: {\n    session_id: sessionId,\n    startup_idea: startupIdea,\n    target_market: targetMarket,\n    founder_context: founderContext,\n    stage: stage,\n    industry: industry,\n    geography: geography,\n    cache_key: `cache_${Math.abs(cacheKey)}_${cacheKeySource.length}`,\n    timestamp: new Date().toISOString()\n  }\n}];"
