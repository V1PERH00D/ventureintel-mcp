    {
      "parameters": {
        "jsCode": "function buildAgentResult(agentName, rawOutput) {\n\n  const text = String(rawOutput || '');\n\n  const scoreMatch =\n    text.match(/SCORE:\\s*(\\d+(?:\\.\\d+)?)/i);\n\n  const confidenceMatch =\n    text.match(/CONFIDENCE:\\s*(\\d+(?:\\.\\d+)?)/i);\n\n  const summaryMatch =\n    text.match(\n      /EXECUTIVE_SUMMARY:\\s*([\\s\\S]*)$/i\n    );\n\n  return {\n    agent_name: agentName,\n    status: 'success',\n    score: scoreMatch\n      ? Number(scoreMatch[1])\n      : null,\n    confidence: confidenceMatch\n      ? Number(confidenceMatch[1])\n      : null,\n    summary: summaryMatch\n      ? summaryMatch[1].trim()\n      : '',\n    report: text,\n    raw_output: text\n  };\n}\n\nfunction selectReport(agentResult) {\n  if (!agentResult) return null;\n  return agentResult.report || agentResult.summary || null;\n}\n\nconst sharedCtx = $('Build Shared Agent Context').first().json;\nconst marketOutput = $('Agent — Market Analyst').first().json?.output ?? $('Agent — Market Analyst').first().json;\nconst competitiveOutput = $('Agent — Competitive Intel').first().json?.output ?? $('Agent — Competitive Intel').first().json;\nconst riskOutput = $('Agent — Risk Assessor').first().json?.output ?? $('Agent — Risk Assessor').first().json;\nconst advisorOutput = $('Agent — Startup Advisor').first().json?.output ?? $('Agent — Startup Advisor').first().json;\n\nconst marketResult =\n  buildAgentResult(\n    'Market Analyst',\n    marketOutput\n  );\nconst competitiveResult =\n  buildAgentResult(\n    'Competitive Intel',\n    competitiveOutput\n  );\n  );\nconst riskResult =\n  buildAgentResult(\n    'Risk Assessor',\n    riskOutput\n  );\nconst advisorResult =\n  buildAgentResult(\n    'Startup Advisor',\n    advisorOutput\n  );\n\nconst analystOutputs = {\n  market_analysis: marketResult,\n  competitive_intel: competitiveResult,\n  risk_assessment: riskResult,\n  startup_advisor: advisorResult\n};\n\nconst failedAgents = [];\n\nconst scores = {\n  market_score: marketResult.score,\n  market_confidence: marketResult.confidence,\n  competitive_score: competitiveResult.score,\n  competitive_confidence: competitiveResult.confidence,\n  risk_score: riskResult.score,\n  risk_confidence: riskResult.confidence,\n  execution_score: advisorResult.score,\n  execution_confidence: advisorResult.confidence\n};\n\nreturn [{\n  json: {\n    session_id: sharedCtx.session_id,\n    cache_key: sharedCtx.cache_key,\n    startup_idea: sharedCtx.startup_idea,\n    target_market: sharedCtx.target_market,\n    stage: sharedCtx.stage,\n    founder_context: sharedCtx.founder_context,\n    geography: sharedCtx.geography,\n    industry: sharedCtx.industry,\n    timestamp: sharedCtx.timestamp,\n    analyst_outputs: analystOutputs,\n    market_summary: marketResult.summary,\n    competitive_summary: competitiveResult.summary,\n    risk_summary: riskResult.summary,\n    advisor_summary: advisorResult.summary,\n    market_report: selectReport(marketResult),\n    competitive_report: selectReport(competitiveResult),\n    risk_report: selectReport(riskResult),\n    advisor_report: selectReport(advisorResult),\n    scores,\n    failed_agents: failedAgents,\n    synthesis_input: {\n      market_summary: marketResult.summary,\n      competitive_summary: competitiveResult.summary,\n      risk_summary: riskResult.summary,\n      advisor_summary: advisorResult.summary,\n      scores\n    }\n  }\n}];"
